KEITARO_API_URL=https://tlgk.host
# URL веб-админки Keitaro (для View In KT). Если пусто — KEITARO_API_URL + /admin.
# Итоговая ссылка: {admin}/#!/campaign/{keitaro_id}/main
# KEITARO_ADMIN_URL=https://tlgk.host/admin
KEITARO_API_KEY=replace-with-your-api-key
KEITARO_DOMAIN_ID=1
# ID группы кампаний. На трекере у FORTESTS = 10332
KEITARO_GROUP_ID=10332
# ID источника трафика. На трекере у FORTESTS = 836
KEITARO_SOURCE_ID=836
